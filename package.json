{
    "name": "xiuxian-game",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "packageManager": "bun@1.4.5",
    "engines": {
        "node": ">=22.12.0",
        "bun": ">=1.4.5"
    },
    "scripts": {
        "dev": "bun --bun vite --open",
        "test": "bun test",
        "assert:files": "bun scripts/assert-files.ts",
        "typecheck": "bun --bun vue-tsc --noEmit",
        "check": "bun run assert:files && bun run typecheck && bun test",
        "build": "bun --bun vite build",
        "preview": "bun --bun vite preview --port 8080"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "crypto-js": "^4.2.0",
        "element-plus": "^2.14.8",
        "file-saver": "^2.0.5",
        "pinia": "^4.1.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vue": "^3.5.46",
        "vue-router": "^5.5.1"
    },
    "devDependencies": {
        "@iconify-json/ep": "^1.2.4",
        "@types/bun": "^1.4.5",
        "@types/crypto-js": "^4.2.2",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^26.6.11",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/devtools-api": "^8.2.1",
        "esbuild": "^0.28.2",
        "javascript-obfuscator": "^5.10.1",
        "terser": "^5.51.4",
        "typescript": "~6.0.3",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.8",
        "vite-plugin-bundle-obfuscator": "^1.14.0",
        "vite-plugin-pwa": "^2.0.0",
        "vue-tsc": "^3.3.14",
        "workbox-build": "^7.4.1",
        "workbox-window": "^7.4.1"
    },
    "overrides": {
        "glob": "^14.0.6",
        "zod": "^4.6.7"
    },
    "trustedDependencies": ["esbuild"]
}
